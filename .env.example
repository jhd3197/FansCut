# Secrets and service addresses for FansCut. Copy to .env (git-ignored) or,
# better, set them in a secret manager such as Doppler. Empty = not set, the
# value in config.yaml is used. A set value always beats config.yaml and is
# never written back to it.

FANSCUT_SONARR_URL=
FANSCUT_SONARR_API_KEY=
FANSCUT_PLEX_URL=
FANSCUT_PLEX_TOKEN=

# Docker-secrets style: path to a file whose contents are the value. Each one
# is ignored when the plain variable above is set.
FANSCUT_SONARR_URL_FILE=
FANSCUT_SONARR_API_KEY_FILE=
FANSCUT_PLEX_URL_FILE=
FANSCUT_PLEX_TOKEN_FILE=
